# Copie para .env e preencha. Nunca versione o .env.
MONGO_URI=mongodb://127.0.0.1:27017/conectea
# Mínimo 32 caracteres. Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SECRET=
PORT=3000
# Opcional: origens permitidas pelo CORS (separadas por vírgula). Necessário para o front-end oficial.
# CORS_ORIGIN=http://localhost:5173
# Opcional: limites de rate limit (padrão: 10 falhas de login / 15 min, 20 cadastros / hora por IP)
# LOGIN_MAX=10
# CADASTRO_MAX=20
