# Copie para .env e preencha. Nunca versione o .env.
# Mínimo 32 caracteres. Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SECRET=
PORT=3000

# --- Firebase / Cloud Firestore (Admin SDK) ---
# ID do projeto no console do Firebase (Configurações do projeto > Geral > ID do projeto).
FIREBASE_PROJECT_ID=
# Caminho do JSON da conta de serviço (Configurações do projeto > Contas de serviço > Gerar nova chave privada).
# Guarde o arquivo FORA do repositório. Deixe vazio para usar Application Default Credentials
# (gcloud auth application-default login, ou a identidade do serviço em Cloud Run/GCP).
GOOGLE_APPLICATION_CREDENTIALS=
# Apenas para desenvolvimento com o emulador (firebase emulators:start --only firestore).
# Quando definido, nenhuma credencial é necessária e NADA é gravado na nuvem.
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080

# Opcional: origens permitidas pelo CORS (separadas por vírgula). Necessário para o front-end oficial.
# CORS_ORIGIN=http://localhost:5173
# Opcional: limites de rate limit (padrão: 10 falhas de login / 15 min, 20 cadastros / hora por IP)
# LOGIN_MAX=10
# CADASTRO_MAX=20
