# Copie para .env e preencha. Nunca versione o .env.
# Mínimo 32 caracteres. Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SECRET=
PORT=3000

# --- Firebase / Cloud Firestore (Admin SDK) ---
# ID do projeto no console do Firebase (Configurações do projeto > Geral > ID do projeto).
FIREBASE_PROJECT_ID=
# Caminho do JSON da conta de serviço (Configurações do projeto > Contas de serviço > Gerar nova chave privada).
# Guarde o arquivo FORA do repositório. Deixe vazio para usar Application Default Credentials
# (gcloud auth application-default login, ou a identidade do serviço em Cloud Run/GCP).
GOOGLE_APPLICATION_CREDENTIALS=
# Apenas para desenvolvimento com o emulador (firebase emulators:start --only firestore).
# Quando definido, nenhuma credencial é necessária e NADA é gravado na nuvem.
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080

# --- Backblaze B2 (arquivos WAV do TTS via API compatível com S3) ---
# Crie uma Application Key restrita ao bucket (permissões de leitura e gravação).
# Endpoint: https://s3.<região>.backblazeb2.com (use a região mostrada no bucket).
B2_ENDPOINT=
B2_REGION=
B2_BUCKET=
B2_KEY_ID=
B2_APPLICATION_KEY=
# Opcional: timeout de chamadas ao Backblaze, em ms (padrão 30000).
# B2_TIMEOUT_MS=30000

# --- Serviço de TTS (Piper) ---
# Endereço do serviço services-tts. No Docker Compose use o nome do serviço, ex.: http://tts:8001
TTS_URL=http://127.0.0.1:8001
# Mesmo valor de TTS_API_KEY do serviço (só se ele exigir X-API-Key)
# TTS_API_KEY=
# Opcional: tempo máximo de espera pelo áudio, em ms (padrão 30000) e limite de caracteres (padrão 500, igual ao do serviço)
# TTS_TIMEOUT_MS=30000
# TTS_MAX_CHARS=500
# Opcional: pedidos de áudio por minuto por IP (padrão 30)
# TTS_MAX_POR_MINUTO=30

# Opcional: origens permitidas pelo CORS (separadas por vírgula). Necessário para o front-end oficial.
# CORS_ORIGIN=http://localhost:5173
# Opcional: limites de rate limit (padrão: 10 falhas de login / 15 min, 20 cadastros / hora por IP)
# LOGIN_MAX=10
# CADASTRO_MAX=20

# Usado pelo Docker Compose (atrás do Nginx). Veja docker-compose.yml. Não defina fora de um proxy.
# TRUST_PROXY=1
